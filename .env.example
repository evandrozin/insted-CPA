# Banco
DATABASE_URL="postgresql://insted:insted@localhost:5433/insted_cpa?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="troque-em-producao"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="troque-em-producao-tambem"
JWT_REFRESH_TTL="30d"

# App
API_PORT=3333
API_URL="http://localhost:3333"
WEB_URL="http://localhost:3000"

# E-mail (dev: mailhog)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="cpa@insted.edu.br"

# Storage (planilhas e PDFs)
S3_ENDPOINT=""
S3_BUCKET="insted-cpa"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Push (Expo)
EXPO_ACCESS_TOKEN=""

# ==== Integração JACAD / SWA (Insted) ====
# Mesmos parâmetros usados pelo Insted Hub Digital.
# O IP da máquina precisa estar liberado no JACAD para as consultas em lote.
JACAD_BASE_URL=https://insted-developer.jacad.com.br
JACAD_USUARIO=integracao
JACAD_TOKEN=
JACAD_PAGE_SIZE=200
JACAD_SLEEP_MS=150
JACAD_TIMEOUT=60

# Assinatura do cookie de sessão do respondente (gere um valor longo e único)
SESSION_SECRET=
